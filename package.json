{
  "name": "@rolandp_86/ngx-monaco-editor",
  "version": "22.0.0",
  "description": "Monaco Code Editor For Angular 22",
  "keywords": [
    "angular 22",
    "monaco",
    "monaco-editor",
    "code",
    "editor",
    "reusable",
    "component"
  ],
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "run-s build-editor serve",
    "serve": "ng serve",
    "build": "ng build --project=editor-tester --base-href=editor-tester --configuration=development",
    "build:prod": "ng build --project=editor-tester --base-href=editor-tester",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "eslint": "npx eslint .",
    "eslint:fix": "npx eslint . --fix",
    "e2e": "ng e2e",
    "build-editor": "ng build editor",
    "npm-publish": "npm run build-editor && bash npm-publish",
    "copy:readme": "copy -rf README.md projects/editor/",
    "update:angular": "ncu --filter \"@angular*\" -u"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/rpanitzek/ngx-monaco-editor"
  },
  "bugs": {
    "url": "https://github.com/rpanitzek/ngx-monaco-editor/issues"
  },
  "author": "Atul Kumar",
  "contributors": [
    "Atul Kumar <atulaggarwal4288@gmail.com>",
    "Roland Panitzek"
  ],
  "dependencies": {
    "@angular/animations": "~22.0.5",
    "@angular/common": "~22.0.5",
    "@angular/compiler": "~22.0.5",
    "@angular/core": "~22.0.5",
    "@angular/forms": "~22.0.5",
    "@angular/platform-browser": "~22.0.5",
    "@angular/platform-browser-dynamic": "~22.0.5",
    "@angular/router": "~22.0.5",
    "@monaco-editor/loader": "^1.7.0",
    "monaco-editor": "^0.55.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "~22.0.5",
    "@angular/compiler-cli": "~22.0.5",
    "@angular/language-service": "~22.0.5",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^24.3.1",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.10.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "^22.0.1",
    "npm-run-all": "^4.1.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.0.8"
  }
}
